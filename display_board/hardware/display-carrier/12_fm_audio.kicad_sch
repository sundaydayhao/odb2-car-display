	(text "Onboard FSV4730-D60-GU replaces unavailable RDA5807M; analog FM stereo, 64..108MHz; no RDS."
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid 40a9b97a-ca1d-5eaa-9a71-abacd8be9795)
	)
	(text "SEN=GND selects 0x11; ES8388=0x10, OPT3001=0x45, SHT40=0x44: no I2C address collision."
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid cc52d66f-965e-5232-9dbb-723a92677374)
	)
	(text "MCP120 delays reset release (700ms max). Hold system I2C idle for 1s after enabling FM power, then poll CTS."
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid aedc2131-5a30-5c8f-b41e-b933cbf95775)
	)
	(text "Crystal connects RCLK to GPO3, with 22pF loads. Firmware enables crystal mode; unused AM input grounded."
		(at 20.32 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid f448b6e7-0288-5f36-b0f8-eff3242cae29)
	)
	(text "Existing independent stereo selector and antenna ESD retained. Port FM driver and verify RF on hardware."
		(at 20.32 40.64 0)
