	(text "OPT3001DNPR: ADDR=3V3 selects 0x45; SHT40-AD1F-R2 fixed 0x44. SYSTEM_I2C, no extra GPIO."
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid a13bb298-4305-5a87-8971-677f97ca0b0b)
	)
	(text "Reuse R110/R111 4.7k bus pull-ups. R1300/R1301 are 22R branch damping; start at 100kHz."
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid a6830cba-b498-5bcb-8d96-8235e055abcf)
	)
	(text "U1300 needs a housing optical window/light guide and LCD stray-light baffle; calibrate assembled optics."
		(at 20.32 30.48 0)
		(effects
			(font
