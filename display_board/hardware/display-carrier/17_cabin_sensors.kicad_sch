			)
			(justify left top)
		)
		(uuid 2bcf8a6d-b973-509c-b0f4-6b91d6a903dd)
	)
	(text "U1301 needs a vented isolated pocket, PCB thermal slots and no copper pour. Heater OFF for cabin readings."
		(at 20.32 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
